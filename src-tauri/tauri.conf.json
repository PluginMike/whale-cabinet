{
  "productName": "Whale Cabinet",
  "mainBinaryName": "whale-cabinet",
  "version": "0.1.0",
  "identifier": "whale-cabinet",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Whale Cabinet",
        "width": 1200,
        "height": 760,
        "decorations": false,
        "transparent": true
      }
    ],
    "security": { "csp": null }
  },
  "bundle": { "active": true, "targets": ["deb", "appimage"], "icon": ["icons/32x32.png", "icons/128x128.png", "icons/icon.png"] }
}
